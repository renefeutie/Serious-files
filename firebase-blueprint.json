{
  "entities": {
    "User": {
      "title": "User",
      "description": "Profil utilisateur sécurisé (client ou commerçant)",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "displayName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["client", "merchant", "admin"] },
        "phoneNumber": { "type": "string", "maxLength": 30 },
        "city": { "type": "string", "maxLength": 60 },
        "district": { "type": "string", "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt", "updatedAt"]
    },
    "Business": {
      "title": "Business",
      "description": "Fiche commerce / établissement artisan MboaFacile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "job": { "type": "string", "maxLength": 120 },
        "category": { "type": "string", "maxLength": 60 },
        "city": { "type": "string", "maxLength": 60 },
        "district": { "type": "string", "maxLength": 80 },
        "address": { "type": "string", "maxLength": 200 },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "phone": { "type": "string", "maxLength": 30 },
        "whatsapp": { "type": "string", "maxLength": 30 },
        "bio": { "type": "string", "maxLength": 1000 },
        "startingPrice": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "cniVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "name", "job", "category", "city", "district", "phone", "status", "createdAt", "updatedAt"]
    },
    "Favorite": {
      "title": "Favorite",
      "description": "Artisan mis en favori par un client",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "artisanId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "artisanId", "createdAt"]
    },
    "BusinessApplication": {
      "title": "BusinessApplication",
      "description": "Demande d'inscription commerçant soumise à vérification",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "businessName": { "type": "string", "maxLength": 120 },
        "ownerName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "whatsapp": { "type": "string", "maxLength": 30 },
        "job": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 60 },
        "city": { "type": "string", "maxLength": 60 },
        "district": { "type": "string", "maxLength": 80 },
        "experienceYears": { "type": "number" },
        "cniNumber": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "businessName", "ownerName", "phone", "job", "category", "city", "district", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Profils utilisateurs sécurisés liés à request.auth.uid"
    },
    "/businesses/{businessId}": {
      "schema": { "$ref": "#/entities/Business" },
      "description": "Établissements des commerçants vérifiés ou en attente"
    },
    "/favorites/{favoriteId}": {
      "schema": { "$ref": "#/entities/Favorite" },
      "description": "Favoris privés des utilisateurs connectés"
    },
    "/businessApplications/{applicationId}": {
      "schema": { "$ref": "#/entities/BusinessApplication" },
      "description": "Dossiers d'enregistrement commerçant"
    }
  }
}
